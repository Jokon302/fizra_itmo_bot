# Токен Telegram-бота от @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Ваш Telegram User ID (для админ-команды /users)
ADMIN_USER_ID=your_telegram_user_id

# Интервал фоновой проверки в минутах (по умолчанию 60 минут)
CHECK_INTERVAL_MINUTES=60

# Автоматически записываться на найденный свободный слот по умолчанию (true/false)
AUTO_SIGN_UP=false

# Путь к каталогу с базой данных (в Docker по умолчанию /app/data)
DATA_DIR=data
